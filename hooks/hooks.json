{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": ["sh", "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh"],
            "timeout": 10
          },
          {
            "type": "command",
            "command": ["sh", "${CLAUDE_PLUGIN_ROOT}/hooks/py.sh", "tagscan.py"],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ["sh", "${CLAUDE_PLUGIN_ROOT}/hooks/py.sh", "lesson-recall.py"],
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ["sh", "${CLAUDE_PLUGIN_ROOT}/hooks/py.sh", "session-end.py"],
            "timeout": 150
          }
        ]
      }
    ]
  }
}
