{
  "description": "교훈(LSN)을 세션 시작과 발화마다 컨텍스트로 되돌리고, 세션 끝에 검색 색인을 갱신한다.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/py.sh",
              "session-start.py"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/py.sh",
              "--quiet",
              "tagscan.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/py.sh",
              "--quiet",
              "lesson-recall.py"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/py.sh",
              "--quiet",
              "session-end.py"
            ],
            "timeout": 150
          }
        ]
      }
    ]
  }
}
