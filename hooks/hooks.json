{
  "description": "교훈(LSN)을 세션 시작과 발화마다 컨텍스트로 되돌린다. Claude Code 와 Codex 양쪽이 받는 형식으로만 적는다 — 명령은 문자열이고 args 배열을 쓰지 않는다.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/py.sh\" session-start.py",
            "timeout": 10,
            "commandWindows": "\"${CLAUDE_PLUGIN_ROOT}\\hooks\\py.cmd\" session-start.py"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/py.sh\" --quiet tagscan.py",
            "timeout": 10,
            "commandWindows": "\"${CLAUDE_PLUGIN_ROOT}\\hooks\\py.cmd\" --quiet tagscan.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/py.sh\" --quiet lesson-recall.py",
            "timeout": 15,
            "commandWindows": "\"${CLAUDE_PLUGIN_ROOT}\\hooks\\py.cmd\" --quiet lesson-recall.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/py.sh\" --quiet session-end.py",
            "timeout": 3,
            "commandWindows": "\"${CLAUDE_PLUGIN_ROOT}\\hooks\\py.cmd\" --quiet session-end.py"
          }
        ]
      }
    ]
  }
}
